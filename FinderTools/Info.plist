			<array><string>public.data</string><string>public.folder</string><string>public.directory</string></array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict><key>default</key><string>在此打开终端</string></dict>
			<key>NSMessage</key><string>openTerminal</string>
