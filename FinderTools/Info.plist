			<key>NSSendFileTypes</key>
			<array><string>public.data</string><string>public.folder</string><string>public.directory</string></array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict><key>default</key><string>用 VS Code 打开</string></dict>
			<key>NSMessage</key><string>openVscode</string>
			<key>NSRequiredContext</key>
			<dict><key>NSApplicationIdentifier</key><string>com.apple.finder</string></dict>
			<key>NSSendFileTypes</key>
			<array><string>public.data</string><string>public.folder</string><string>public.directory</string></array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict><key>default</key><string>显示/隐藏 隐藏文件</string></dict>
			<key>NSMessage</key><string>toggleHidden</string>
			<key>NSRequiredContext</key>
			<dict><key>NSApplicationIdentifier</key><string>com.apple.finder</string></dict>
			<key>NSSendFileTypes</key>
			<array><string>public.data</string><string>public.folder</string><string>public.directory</string></array>
		</dict>
	</array>
</dict>
